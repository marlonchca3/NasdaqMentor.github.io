// Firebase Storage rules for Nasdaq Mentor
// Allow authenticated users to read/write only files under /users/{uid}/...
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read/write inside users/{userId}/ for that authenticated user
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny other access by default
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
