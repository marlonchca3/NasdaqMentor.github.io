// Firestore security rules for Nasdaq Mentor
// Allow authenticated users to read/write only their own documents under /users/{uid}/...
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow full access under users/{userId} only when authenticated as that user
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny access to other root collections by default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
